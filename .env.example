# Copy this file to `.env` for local development OR set these in your hosting provider (Vercel, Netlify, etc.)

# --- Database (wajib untuk menyimpan konfigurasi Supabase di panel admin) ---
# Untuk development, isi dengan URL Postgres lokal.
# Untuk production (Vercel/Neon/Railway), ganti dengan Postgres URL yang disediakan platform.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/app_db"

# --- Supabase (opsional) ---
# Jika diisi, admin panel tidak bisa mengubah credentials dari UI.
# Jika kosong, admin bisa memasukkan URL + Anon Key dari halaman admin.
SUPABASE_URL=""
SUPABASE_ANON_KEY=""

# --- Admin password ---
# Password untuk halaman admin dan tombol edit skor di halaman bagan.
# Default: admin123
ADMIN_PASSWORD="admin123"
